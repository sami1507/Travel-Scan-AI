# ── Supabase (Required) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── OpenAI (Required for AI-powered analysis) ──────────────────
OPENAI_API_KEY=your_openai_api_key

# ── App URL (update for production deployment) ─────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Claude/Anthropic (Optional — accuracy verification + chat mode) ─
# Set ENABLE_CLAUDE_VERIFIER=true to enable Claude verification.
# Claude will verify recommendations for accuracy but won't block if it fails.
# Also required for the chat-mode conversational intake (/api/chat/travel).
ENABLE_CLAUDE_VERIFIER=false
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-5

# ── Tavily (Optional — AI price estimation + travel context search) ─
TAVILY_API_KEY=your_tavily_api_key

# ── Duffel (Optional — real flight data, falls back to AI estimation) ─
DUFFEL_API_TOKEN=your_duffel_api_token
DUFFEL_ENVIRONMENT=test

# ── Hotelbeds (Optional — real hotel data, falls back to AI estimation) ─
HOTELBEDS_API_KEY=your_hotelbeds_api_key
HOTELBEDS_API_SECRET=your_hotelbeds_api_secret
HOTELBEDS_ENVIRONMENT=test

# ── Google Places / Maps (Optional — venue enrichment + route maps) ─
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_PLACES_API_KEY=your_google_places_api_key
ENABLE_GOOGLE_PLACES_ENRICHMENT=false

# ── Live exchange rates (Optional — falls back to a static rate snapshot) ─
EXCHANGERATE_API_KEY=your_exchangerate_api_key

# ── Stripe (Optional — subscriptions/billing) ───────────────────
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_PRO_PRICE_ID=your_stripe_price_id
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret

# ── Vercel Cron (Optional — required if the /api/trigger-all cron job is enabled) ─
# Vercel automatically sends this as a Bearer token when invoking scheduled cron jobs.
# Generate any long random string and set the same value in Vercel's environment variables.
CRON_SECRET=your_random_cron_secret
ENABLE_TRIGGER_ROUTES=false

# ── Vercel KV / Upstash Redis (Optional — rate limiting + response caching) ─
KV_REST_API_URL=your_kv_rest_api_url
KV_REST_API_TOKEN=your_kv_rest_api_token

# ── Feature flags (Optional) ────────────────────────────────────
ENABLE_AI_LEARNING=true

# ── Reserved for future providers (not yet wired into any code path) ─
# TICKETMASTER_DISCOVERY_API_KEY=your_ticketmaster_api_key
# WEATHER_API_KEY=your_weather_api_key
